# VWorld Crawl — Environment Variables

# --- Catalog Backend ---
# "duckdb" (default) or "postgresql"
VWORLD_CATALOG_TYPE=duckdb
VWORLD_CATALOG_PATH=catalog/vworld_catalog.db

# --- DuckLake ---
VWORLD_DUCKLAKE_CATALOG=vworld
VWORLD_DUCKLAKE_DATA_PATH=vworld_data/
VWORLD_DUCKLAKE_METADATA_PATH=catalog/ducklake_metadata.ducklake

# --- PostgreSQL (only if VWORLD_CATALOG_TYPE=postgresql) ---
# VWORLD_PG_HOST=localhost
# VWORLD_PG_PORT=5432
# VWORLD_PG_DB=vworld_catalog
# VWORLD_PG_USER=vworld
# VWORLD_PG_PASSWORD=

# --- Server ---
VWORLD_HOST=127.0.0.1
VWORLD_PORT=8000
VWORLD_RELOAD=false

# --- VWorld API Credentials ---
VWORLD_URL=
VWORLD_USERNAME=
VWORLD_PASSWORD=
